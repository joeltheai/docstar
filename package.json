{
  "name": "docstar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && pnpm run --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @docstar/server db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.0.0-beta.43"
    }
  }
}
